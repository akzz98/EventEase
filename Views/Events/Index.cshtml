@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Index";
}

<h2 class="mb-4">Events Management</h2>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">+ Create New</a>
</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="searchString">Search</label>
                <input type="text"
                       id="searchString"
                       name="searchString"
                       value="@ViewData["CurrentFilter"]"
                       class="form-control"
                       placeholder="Event ID, name, type..." />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="eventTypeId">Event Type</label>
                <select name="eventTypeId" id="eventTypeId" class="form-select" asp-items="ViewBag.EventTypeId">
                    <option value="">All types</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="fromDate">From Date</label>
                <input type="date"
                       id="fromDate"
                       name="fromDate"
                       value="@ViewData["FromDateFilter"]"
                       class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="toDate">To Date</label>
                <input type="date"
                       id="toDate"
                       name="toDate"
                       value="@ViewData["ToDateFilter"]"
                       class="form-control" />
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No events found matching your filters.</div>
}
else
{
<table class="table table-striped table-hover table-bordered shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventTypeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlannedStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlannedEndDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @(item.EventType?.Name ?? "—")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PlannedStartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PlannedEndDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
}
