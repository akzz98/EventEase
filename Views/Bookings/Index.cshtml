@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Booking Management";
}

<h2 class="mb-4">Booking Management</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Create New Booking</a>
</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="searchString">Search</label>
                <input type="text"
                       id="searchString"
                       name="searchString"
                       value="@ViewData["CurrentFilter"]"
                       class="form-control"
                       placeholder="Booking ID or event name..." />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="eventTypeId">Event Type</label>
                <select name="eventTypeId" id="eventTypeId" class="form-select" asp-items="ViewBag.EventTypeId">
                    <option value="">All types</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="venueId">Venue</label>
                <select name="venueId" id="venueId" class="form-select" asp-items="ViewBag.VenueId">
                    <option value="">All venues</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="fromDate">From Date</label>
                <input type="date"
                       id="fromDate"
                       name="fromDate"
                       value="@ViewData["FromDateFilter"]"
                       class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="toDate">To Date</label>
                <input type="date"
                       id="toDate"
                       name="toDate"
                       value="@ViewData["ToDateFilter"]"
                       class="form-control" />
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No bookings found matching your filters.</div>
}
else
{
    <table class="table table-striped table-hover table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Venue Name</th>
                <th>Venue Location</th>
                <th>Event Name</th>
                <th>Start Date & Time</th>
                <th>End Date & Time</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.BookingId</td>
                    <td>@item.Venue?.Name</td>
                    <td>@item.Venue?.Location</td>
                    <td>@item.Event?.Name</td>
                    <td>@item.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@item.EndDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        <span class="badge @BookingStatuses.GetBadgeClass(item.Status)">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
